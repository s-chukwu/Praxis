# Copy to .env and fill in. Never commit .env.

# Shared
PRAXIS_ENV=local

# Shared HMAC secret for backend to assessment calls. At least 32 bytes.
# Generate one with: openssl rand -hex 32
AI_SERVICE_SHARED_SECRET=
# Set only while rotating the secret.
AI_SERVICE_SHARED_SECRET_PREVIOUS=

# Backend
PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Postgres connection string for the backend. Use the Supabase pooler URL.
DATABASE_URL=

# Supabase (backend only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional backend settings
# BASELINE_SCENARIO_ID=CS-01-A
# SENTRY_DSN=
# PRAXIS_RELEASE=

# Frontend (browser-visible, set at build time)
# demo keeps learner state in the browser. Use live to call the API.
NEXT_PUBLIC_API_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev only: use the sample learner without sign-up.
# NEXT_PUBLIC_PREVIEW=1

# Assessment
# GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Local only: folder with assessor_keys/ and capstone_held_out/.
# From AI_Assessment/service, use ../tests/fixtures. The compose file mounts it at /protected.
# PRAXIS_PROTECTED_CONTENT_DIR=../tests/fixtures
# PRAXIS_CONTENT_DIR=

# Production only: the assessment service reads protected content from Azure Key Vault.
# AZURE_KEY_VAULT_URL=
# AZURE_CLIENT_ID=
# ASSESSOR_KEYS_SECRET_NAME=
# CAPSTONE_HELD_OUT_SECRET_NAME=
