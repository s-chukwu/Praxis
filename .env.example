# Copy to .env and fill in. Never commit .env.

# Frontend (browser-visible)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend (server-side, inside docker network)
API_INTERNAL_URL=http://backend:8080

# Backend
PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000

# AI / assessment service
AI_SERVICE_URL=http://ai:8000
PRAXIS_ENV=local

# Shared HMAC secret for Go -> Python internal calls. At least 32 bytes.
# Generate one with: openssl rand -hex 32
AI_SERVICE_SHARED_SECRET=
AI_SERVICE_SHARED_SECRET_PREVIOUS=

# AI providers (server-side only)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Supabase (backend only; the anon key may also be used by the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
